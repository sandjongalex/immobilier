# Copier sous backend/.env et renseigner des valeurs LOCALES.
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Instance PostgreSQL existante à créer/configurer séparément.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Production uniquement : chemin persistant hors du dépôt (optionnel en dev).
# DJANGO_MEDIA_ROOT=/srv/immobilier/media
# DJANGO_HSTS_SECONDS=0
